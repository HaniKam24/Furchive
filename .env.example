# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Postgres connection string (Supabase: Project Settings -> Database ->
# Connection string -> URI). Use the Direct connection or Session pooler
# string, not Transaction pooler — this app holds one long-lived pg.Pool,
# not a serverless connection per invocation.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# better-auth session/token signing secret. Any long random string, e.g.
# `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Resend (resend.com -> API Keys) — sends the "verify your email" link on
# signup. Required: email/password sign-in is blocked until verified.
# RESEND_FROM_EMAIL is optional — defaults to Resend's sandbox sender,
# which only delivers to the email on the Resend account itself until a
# real sending domain is verified there (resend.com -> Domains).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# @better-auth/infra dash() plugin API key, from the Better Auth dashboard
# (dashboard.better-auth.com -> your project -> Install Plugin step).
BETTER_AUTH_API_KEY=

# The api-server's own public base URL (used by better-auth for cookies/CSRF).
# Local dev default matches the port in replit.md.
BETTER_AUTH_URL=http://localhost:5000

# Comma-separated frontend origin(s). Needed both when the web app isn't
# served same-origin with the api-server (e.g. local dev, where the
# frontend runs on a different port) AND, as of VITE_API_BASE_URL below,
# for the frontend's direct auth requests in every environment — this is
# what the api-server's CORS config and better-auth's trustedOrigins check
# against.
WEB_ORIGIN=

# "Sign in with Google" button. From Google Cloud Console -> APIs & Services
# -> Credentials -> OAuth client ID (type: Web application). Add
# {BETTER_AUTH_URL}/api/auth/callback/google as an authorized redirect URI
# there. Leave both blank to skip Google sign-in (it's omitted automatically).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend-only, read at BUILD time by Vite — goes in
# artifacts/pet-health-companion/.env (its own directory, not this root
# file), not read by the api-server at all. The api-server's own public
# URL (same value as BETTER_AUTH_URL above). Needed for "Sign in with
# Google" specifically: Google's OAuth callback redirects the browser
# straight to this address, bypassing the usual same-origin /api/* proxy
# path every other request uses — so the short-lived state cookie
# better-auth sets right before redirecting to Google has to already be
# scoped to this same address, which only happens if the frontend calls it
# directly instead of through the proxy. See auth-client.ts for the full
# explanation.
# VITE_API_BASE_URL=http://localhost:5000

# "Sign in with Apple" was dropped for now — it needs a paid ($99/year)
# Apple Developer account. Revisit later if that becomes worth it.

# Supabase project URL (Project Settings -> API -> Project URL) and the
# service-role (secret) key from the same page — NOT the publishable/anon
# key. Used server-side only, to write health-record attachments to a
# private Supabase Storage bucket. Never expose the service-role key to
# the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key (console.anthropic.com -> API Keys) — powers symptom
# chat and Smart Document Upload extraction. Server-side only.
ANTHROPIC_API_KEY=

# Sentry error tracking (sentry.io -> Settings -> Projects -> [project] ->
# Client Keys (DSN)). Optional — the app runs fine without it, errors just
# won't be reported anywhere. Error Monitoring only; Logs/Metrics/Tracing/
# Profiling are deliberately not enabled for this project.
SENTRY_DSN=
